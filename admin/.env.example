# 腾讯云开发环境配置
# 复制此文件为 .env 并填入真实的配置值

# 腾讯云开发 Access Key
# 获取方式：
# 1. 登录腾讯云控制台 https://console.cloud.tencent.com/tcb
# 2. 进入你的云开发环境
# 3. 点击"环境设置" -> "访问密钥"
# 4. 创建或复制现有的 Access Key
VITE_APP_TCB_ACCESS_KEY=your-access-key-here

# API 基础地址（可选，使用默认值即可）
# 格式：https://{环境ID}.service.tcloudbase.com/api
VITE_APP_API_BASE_URL=https://dayup-02-8gpzk22z15cf48a9.service.tcloudbase.com/api
