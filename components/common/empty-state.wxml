<!-- empty-state.wxml -->
<view class="empty-state">
  <view class="empty-icon">
    <text class="icon">{{ icon || '📭' }}</text>
  </view>
  <view class="empty-main-text">{{ text || '暂无数据' }}</view>
  <view wx:if="{{ subText }}" class="empty-sub-text">{{ subText }}</view>
  <button wx:if="{{ btnText }}" class="empty-btn" bindtap="handleBtnClick">{{ btnText }}</button>
</view>