<!-- pages/students/index.wxml -->
<view class="container">
  <!-- 顶部：筛选按钮 -->
  <view class="header">
    <view class="header-title">学生列表</view>
    <view class="filter-btn" bindtap="showFilter">
      <text class="filter-text">筛选</text>
    </view>
  </view>
  
  <!-- 学生列表 -->
  <view class="student-list">
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
    
    <view wx:elif="{{filteredStudents.length === 0}}" class="empty-state">
      <text class="empty-icon">👨‍🎓</text>
      <text class="empty-text">暂无学生</text>
      <text class="empty-tip">请在后台管理系统添加学生</text>
    </view>
    
    <view wx:for="{{filteredStudents}}" wx:key="id" class="student-card" data-id="{{item.id}}" bindtap="showStudentDetail">
      <view class="student-content">
        <view class="student-info">
          <text class="student-name">{{item.name}}</text>
          <text class="student-class">{{item.school}} {{item.className}}</text>
        </view>
        <view class="student-details">
          <text class="detail-item">家长：{{item.parentPhone}}</text>
          <text class="detail-item status-{{item.status}}">{{item.status === 'active' ? '在读' : '休学'}}</text>
        </view>
      </view>
    </view>
    
    <!-- 学生统计 -->
    <view class="student-count-bottom" wx:if="{{!loading && filteredStudents.length > 0}}">
      <text class="count-number">{{filteredStudents.length}}</text>
      <text class="count-label">名学生</text>
    </view>
  </view>
  
  <!-- 筛选弹窗 -->
  <view wx:if="{{showFilterModal}}" class="modal" catchtap="hideFilter">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">筛选</text>
        <text class="modal-close" bindtap="hideFilter">×</text>
      </view>
      <view class="modal-body">
        <!-- 学校筛选 -->
        <view class="filter-section" wx:if="{{schools.length > 0}}">
          <text class="filter-label">学校</text>
          <view class="filter-options">
            <view wx:for="{{schools}}" wx:key="{{item}}" class="filter-option {{filters.school === item ? 'active' : ''}}" bindtap="setFilter" data-key="school" data-value="{{item}}">
              {{item}}
            </view>
            <view class="filter-option {{filters.school === '' ? 'active' : ''}}" bindtap="setFilter" data-key="school" data-value="">
              全部
            </view>
          </view>
        </view>
        
        <!-- 班级筛选 -->
        <view class="filter-section" wx:if="{{classNames.length > 0}}">
          <text class="filter-label">班级</text>
          <view class="filter-options">
            <view wx:for="{{classNames}}" wx:key="{{item}}" class="filter-option {{filters.className === item ? 'active' : ''}}" bindtap="setFilter" data-key="className" data-value="{{item}}">
              {{item}}
            </view>
            <view class="filter-option {{filters.className === '' ? 'active' : ''}}" bindtap="setFilter" data-key="className" data-value="">
              全部
            </view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="footer-btn" bindtap="resetFilter">重置</view>
        <view class="footer-btn primary" bindtap="applyFilter">应用</view>
      </view>
    </view>
  </view>
</view>
