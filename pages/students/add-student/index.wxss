/* pages/students/add-student/index.wxss */

.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 32rpx 24rpx;
  padding-bottom: 160rpx;
}

.form {
  padding: 0;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-of-type {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.form-item-half {
  flex: 1;
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: 2rpx solid #E8E8E8;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: 2rpx solid #E8E8E8;
  box-sizing: border-box;
  min-height: 160rpx;
}

.picker {
  width: 100%;
}

.picker-content {
  height: 88rpx;
  line-height: 88rpx;
  background: #FFFFFF;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: 2rpx solid #E8E8E8;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-content.placeholder {
  color: #999999;
}

.picker-content.selected {
  color: #333333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

.address-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.address-item {
  flex: 1;
}

.address-input {
  margin-top: 16rpx;
}

.form-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 48rpx;
  padding: 32rpx 48rpx;
  border-top: 2rpx solid #E8E8E8;
  justify-content: center;
}

.submit-btn {
  width: 180rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #1890FF 0%, #096DD9 100%);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.cancel-btn {
  width: 180rpx;
  height: 72rpx;
  background: #FFFFFF;
  color: #666;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: 2rpx solid #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.cancel-btn:active {
  background: #F5F5F5;
  transform: scale(0.98);
}

.required {
  color: #FF4D4F;
  margin-left: 8rpx;
}

/* 输入框错误样式 */
.input-error {
  border-color: #FF4D4F !important;
  background-color: #FFF2F0 !important;
}

/* 错误提示文字 */
.error-text {
  display: block;
  font-size: 26rpx;
  color: #FF4D4F;
  margin-top: 12rpx;
  margin-left: 8rpx;
}

/* 抖动动画 */
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-8rpx); }
  20%, 40%, 60%, 80% { transform: translateX(8rpx); }
}

.shake {
  animation: shake 0.5s ease-in-out;
}

@media (max-width: 375px) {
  .container {
    padding: 24rpx 16rpx;
    padding-bottom: 140rpx;
  }
  
  .form-item {
    margin-bottom: 28rpx;
  }
  
  .form-row {
    gap: 16rpx;
    margin-bottom: 28rpx;
  }
  
  .label {
    font-size: 28rpx;
    margin-bottom: 12rpx;
  }
  
  .input {
    height: 80rpx;
    line-height: 80rpx;
    font-size: 28rpx;
    padding: 0 20rpx;
  }
  
  .textarea {
    font-size: 28rpx;
    padding: 20rpx;
    min-height: 140rpx;
  }
  
  .picker-content {
    height: 80rpx;
    line-height: 80rpx;
    font-size: 28rpx;
    padding: 0 20rpx;
  }
  
  .picker-arrow {
    font-size: 22rpx;
  }

  .address-row {
    gap: 12rpx;
    margin-bottom: 16rpx;
  }

  .address-input {
    margin-top: 12rpx;
  }

  .form-actions {
    margin-top: 40rpx;
    padding: 24rpx 0;
  }
  
  .submit-btn,
  .cancel-btn {
    width: 160rpx;
    height: 64rpx;
    font-size: 26rpx;
    border-radius: 32rpx;
  }
}