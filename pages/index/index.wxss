/* pages/index/index.wxss */

.container {
  padding: 40rpx 20rpx;
  min-height: 100vh;
  background-color: var(--bg-gray);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.subtitle {
  font-size: 18rpx;
  color: var(--text-secondary);
  display: block;
}

.role-cards {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.role-card {
  background-color: var(--white);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.role-card:active {
  transform: scale(0.98);
}

.parent-card {
  border-left: 8rpx solid #3366FF;
}

.teacher-card {
  border-left: 8rpx solid #33CC66;
}

.role-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.role-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.role-desc {
  font-size: 16rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}
