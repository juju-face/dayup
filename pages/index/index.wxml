<!-- pages/index/index.wxml -->
<view class="container">
  <view class="header">
    <text class="title">欢迎使用托管服务</text>
    <text class="subtitle">请选择您的角色</text>
  </view>
  
  <view class="role-cards">
    <view class="role-card parent-card" bindtap="selectRole" data-role="parent">
      <view class="role-icon">👨‍👩‍👧‍👦</view>
      <view class="role-title">家长端</view>
      <view class="role-desc">查看托管时段，管理孩子信息，查看报名记录</view>
    </view>
    
    <view class="role-card teacher-card" bindtap="selectRole" data-role="teacher">
      <view class="role-icon">👩‍🏫</view>
      <view class="role-title">老师端</view>
      <view class="role-desc">管理签到记录，查看托管情况，处理报名信息</view>
    </view>
  </view>
</view>