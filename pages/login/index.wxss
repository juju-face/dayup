.container {
  min-height: 100vh;
  padding: 80rpx 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

/* 家长端主题 */
.parent-theme {
  background: linear-gradient(180deg, #FFF8F0 0%, #FFFFFF 100%);
}

.parent-theme .logo {
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A6B 100%);
  box-shadow: 0 12rpx 32rpx rgba(255, 122, 69, 0.25);
}

.parent-theme .role-item.active {
  border-color: #FF7A45;
  background: #FFF8F0;
}

.parent-theme .code-btn {
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A6B 100%);
}

.parent-theme .login-btn {
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A6B 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.3);
}

/* 教师端主题 */
.teacher-theme {
  background: linear-gradient(180deg, #F0F5FF 0%, #FFFFFF 100%);
}

.teacher-theme .logo {
  background: linear-gradient(135deg, #6B73FF 0%, #8B5CF6 100%);
  box-shadow: 0 12rpx 32rpx rgba(107, 115, 255, 0.25);
}

.teacher-theme .role-item.active {
  border-color: #6B73FF;
  background: #F0F5FF;
}

.teacher-theme .code-btn {
  background: linear-gradient(135deg, #6B73FF 0%, #8B5CF6 100%);
}

.teacher-theme .login-btn {
  background: linear-gradient(135deg, #6B73FF 0%, #8B5CF6 100%);
  box-shadow: 0 8rpx 24rpx rgba(107, 115, 255, 0.3);
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  transition: all 0.3s ease;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

.slogan {
  font-size: 28rpx;
  color: #999;
}

/* 角色选择 */
.role-section {
  display: flex;
  gap: 32rpx;
  margin-bottom: 64rpx;
}

.role-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.role-icon {
  font-size: 56rpx;
}

.role-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 登录表单 */
.form-section {
  margin-bottom: 80rpx;
}

/* 输入框容器 - 统一样式 */
.input-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  height: 104rpx;
  box-sizing: border-box;
}

/* 输入框 - 统一样式 */
.input-field {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 100%;
  line-height: 104rpx;
}

/* 验证码输入框容器 */
.code-item {
  padding: 0 24rpx 0 32rpx;
}

/* 验证码输入框 */
.code-input {
  flex: 1;
  height: 100%;
  line-height: 104rpx;
}

/* 获取验证码按钮 */
.code-btn {
  border-radius: 48rpx;
  padding: 16rpx 28rpx;
  margin-left: 16rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.code-btn.disabled {
  background: #F5F5F5 !important;
}

.code-btn-text {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
  white-space: nowrap;
}

.code-btn.disabled .code-btn-text {
  color: #999;
}

/* 登录按钮 */
.login-btn {
  border-radius: 48rpx;
  padding: 32rpx;
  text-align: center;
  margin-top: 48rpx;
  transition: all 0.3s ease;
}

.login-btn-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

/* 底部提示 */
.footer {
  margin-top: auto;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}
