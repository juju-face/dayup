<view class="container {{isTeacher ? 'teacher-theme' : 'parent-theme'}}">
  <!-- 顶部Logo区域 -->
  <view class="logo-section">
    <view class="logo">
      <text class="logo-text">DayUp</text>
    </view>
    <text class="slogan">{{isTeacher ? '欢迎老师' : '欢迎家长'}}</text>
  </view>

  <!-- 角色选择 -->
  <view class="role-section">
    <view 
      class="role-item {{!isTeacher ? 'active' : ''}}" 
      data-role="parent"
      bindtap="switchRole"
    >
      <text class="role-icon">👨‍👩‍👧</text>
      <text class="role-text">家长</text>
    </view>
    <view 
      class="role-item {{isTeacher ? 'active' : ''}}" 
      data-role="teacher"
      bindtap="switchRole"
    >
      <text class="role-icon">👨‍🏫</text>
      <text class="role-text">老师</text>
    </view>
  </view>

  <!-- 登录表单 -->
  <view class="form-section">
    <view class="input-item">
      <input 
        class="input-field" 
        type="number" 
        maxlength="11" 
        placeholder="请输入手机号" 
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-item code-item">
      <input 
        class="input-field code-input" 
        type="number" 
        maxlength="6" 
        placeholder="请输入验证码" 
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <view 
        class="code-btn {{countdown > 0 ? 'disabled' : ''}}" 
        bindtap="{{countdown > 0 ? '' : 'getCode'}}"
      >
        <text class="code-btn-text">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
      </view>
    </view>

    <view class="login-btn" bindtap="handleLogin">
      <text class="login-btn-text">登录</text>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="footer">
    <text class="footer-text">登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>
