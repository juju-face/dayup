/* 全局样式 */
page {
  background: linear-gradient(180deg, #EBF5FF 0%, #F5F7FA 100%);
  font-family: 'PingFang SC', sans-serif;
}

.profile-container {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 老师信息卡片 */
.teacher-card {
  background: white;
  margin: 32rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
}

.teacher-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #40A9FF 0%, #1890FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: white;
  font-weight: bold;
}

.teacher-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.teacher-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.teacher-school {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.teacher-actions {
  margin-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.edit-arrow {
  font-size: 48rpx;
  color: #CCC;
  font-weight: bold;
  transition: color 0.3s ease;
}

.teacher-actions:active .edit-arrow {
  color: #1890FF;
}

/* 班级选择器 */
.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #E8E8E8;
  min-width: 180rpx;
}

.picker-value {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-right: 8rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 卡片通用样式 */
.overview-card,
.tools-card,
.insight-card,
.parent-card {
  background: white;
  margin: 32rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.header-right {
  flex-shrink: 0;
}

/* 今日概览 */
.overview-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.overview-item {
  flex: 1;
  text-align: center;
  padding: 0 12rpx;
}

.overview-number {
  font-size: 56rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
  margin-bottom: 8rpx;
}

.overview-number.blue {
  color: #1890FF;
}

.overview-number.green {
  color: #52C41A;
}

.overview-number.orange {
  color: #FF7A45;
}

.overview-number.red {
  color: #FF4D4F;
}

.overview-number.gray {
  color: #666;
}

.percent-sign {
  font-size: 32rpx;
}

.overview-label {
  font-size: 24rpx;
  color: #666;
}

.trend-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

/* 效率工具 */
.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.1s ease;
}

.tool-item:active {
  transform: scale(0.95);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.tool-icon.blue-gradient {
  background: linear-gradient(135deg, #40A9FF 0%, #1890FF 100%);
}

.tool-icon.purple-gradient {
  background: linear-gradient(135deg, #B37FEB 0%, #722ED1 100%);
}

.tool-icon.cyan-gradient {
  background: linear-gradient(135deg, #36CFC9 0%, #13C2C2 100%);
}

.tool-icon.orange-gradient {
  background: linear-gradient(135deg, #FFC069 0%, #FA8C16 100%);
}

.tool-icon .icon {
  font-size: 48rpx;
  color: white;
}

.tool-label {
  font-size: 26rpx;
  color: #1A1A1A;
  text-align: center;
}

.arrow {
  font-size: 32rpx;
  color: #CCC;
  font-weight: bold;
}





/* 底部 */
.footer {
  text-align: center;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.version {
  font-size: 24rpx;
  color: #999;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

@keyframes countUp {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

.pulse {
  animation: pulse 1s infinite;
}

/* 头像选择弹窗 */
.avatar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 防止背景滚动 */
.avatar-modal::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: white;
  border-radius: 24rpx;
  width: 80%;
  max-width: 500rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  z-index: 10000;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  font-weight: bold;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin: 32rpx 0;
}

.avatar-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  overflow: hidden;
}

.avatar-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.avatar-item.selected {
  border-color: #1890FF;
  background: #E8F3FF;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.cancel-button,
.confirm-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  position: relative;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-button {
  background: #F5F7FA;
  color: #666;
  border: 1rpx solid #E8E8E8;
}

.confirm-button {
  background: #1890FF;
  color: white;
}

button {
  border-radius: 12rpx;
}

button[type="primary"] {
  background: #1890FF;
  color: white;
}

button[type="default"] {
  background: #F5F7FA;
  color: #666;
  border: 1rpx solid #E8E8E8;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .overview-number {
    font-size: 48rpx;
  }
  
  .tool-icon {
    width: 72rpx;
    height: 72rpx;
  }
  
  .tool-icon .icon {
    font-size: 40rpx;
  }
  
  .parent-button {
    height: 80rpx;
    font-size: 24rpx;
  }
  
  .avatar-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .avatar-item {
    width: 64rpx;
    height: 64rpx;
  }
  
  .avatar-emoji {
    font-size: 32rpx;
  }
}

/* 任务模态框 */
.task-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 防止背景滚动 */
.task-modal::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: white;
  border-radius: 24rpx;
  width: 80%;
  max-width: 600rpx;
  max-height: 80vh;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  z-index: 10000;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  font-weight: bold;
  cursor: pointer;
}

.modal-body {
  margin-bottom: 24rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E8E8E8;
}

/* 任务项 */
.task-item {
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.task-student-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.student-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.student-class {
  font-size: 24rpx;
  color: #666;
}

.task-content {
  margin-bottom: 16rpx;
}

.task-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.task-submit-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.task-description {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  white-space: pre-wrap;
}

.task-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

/* 表单项目 */
.form-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.label {
  width: 120rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
}

.textarea {
  flex: 1;
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  padding: 16rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  resize: none;
  line-height: 1.4;
}

/* 按钮样式 */
.cancel-button,
.confirm-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  position: relative;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-button {
  background: #F5F7FA;
  color: #666;
  border: 1rpx solid #E8E8E8;
}

.confirm-button {
  background: #1890FF;
  color: white;
}

/* 订正按钮样式 */
button.correct-button {
  background: #FF4D4F !important;
  color: white !important;
  border: 1rpx solid #FF4D4F !important;
}