<view class="edit-profile-container">
  <!-- 编辑表单 -->
  <form class="form" bindsubmit="formSubmit">
    <!-- 头像选择弹窗 -->
    <view class="avatar-modal" wx:if="{{showAvatarModal}}" catchtouchmove="preventScroll">
      <view class="modal-overlay" bindtap="hideAvatarModal" catchtouchmove="preventScroll"></view>
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title">选择头像</text>
          <text class="modal-close" bindtap="hideAvatarModal">×</text>
        </view>
        <view class="avatar-grid">
          <view wx:for="{{avatarChoices}}" wx:key="index" 
                class="avatar-item {{selectedAvatar === index ? 'selected' : ''}}"
                bindtap="selectAvatar" data-index="{{index}}">
            <text class="avatar-emoji">{{item}}</text>
          </view>
        </view>
        <view class="modal-footer">
          <button type="default" class="cancel-button" bindtap="hideAvatarModal">取消</button>
          <button type="primary" class="confirm-button" bindtap="confirmAvatar">确定</button>
        </view>
      </view>
    </view>

    <!-- 头像与基本信息 -->
    <view class="form-section">
      <view class="profile-info-section">
        <view class="avatar-section" bindtap="showAvatarModal">
          <view class="current-avatar">
            <text class="avatar-text">{{teacherInfo.avatarText}}</text>
          </view>
          <text class="change-avatar-text">更换头像</text>
        </view>
        <view class="basic-info">
          <view class="form-item">
            <text class="label">姓名</text>
            <input type="text" name="name" value="{{teacherInfo.name}}" placeholder="请输入姓名" class="input" />
          </view>
          <view class="form-item">
            <text class="label">校区</text>
            <input type="text" name="school" value="{{teacherInfo.school}}" placeholder="请输入校区" class="input" />
          </view>
          <view class="form-item">
            <text class="label">手机号</text>
            <input type="number" name="phone" value="{{teacherInfo.phone}}" placeholder="请输入手机号" class="input" />
          </view>
        </view>
      </view>
    </view>

    <!-- 保存按钮 -->
    <view class="form-section">
      <button type="primary" form-type="submit" class="save-btn">保存</button>
    </view>
  </form>
</view>