/* 全局样式 */
page {
  background: #F5F7FA;
  font-family: 'PingFang SC', sans-serif;
}

.edit-profile-container {
  min-height: 100vh;
  padding-bottom: 32rpx;
}

/* 表单部分 */
.form-section {
  background: white;
  margin: 16rpx 0;
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

/* 头像与基本信息区域 */
.profile-info-section {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 32rpx;
}

/* 头像编辑 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  cursor: pointer;
  flex-shrink: 0;
}

.current-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #40A9FF 0%, #1890FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-text {
  font-size: 48rpx;
  color: white;
  font-weight: bold;
  line-height: 1;
}

.change-avatar-text {
  font-size: 24rpx;
  color: #1890FF;
  font-weight: 500;
  padding: 12rpx 24rpx;
  border: 2rpx solid #1890FF;
  border-radius: 12rpx;
  background: #E8F3FF;
}

/* 基本信息区域 */
.basic-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 32rpx;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin: 32rpx 0;
}

.avatar-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F7FA;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  overflow: hidden;
}

.avatar-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.avatar-item.selected {
  border-color: #1890FF;
  background: #E8F3FF;
}

/* 头像选择弹窗 */
.avatar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 防止背景滚动 */
.avatar-modal::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  overflow: hidden;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: white;
  border-radius: 24rpx;
  width: 80%;
  max-width: 500rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  z-index: 10000;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.modal-close {
  font-size: 32rpx;
  color: #999;
  font-weight: bold;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.cancel-button,
.confirm-button {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  position: relative;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.cancel-button {
  background: #F5F7FA;
  color: #666;
  border: 1rpx solid #E8E8E8;
}

.confirm-button {
  background: #1890FF;
  color: white;
}

/* 表单输入项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 100rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
  padding: 0 12rpx;
}

/* 文本域 */
.textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  padding: 16rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  resize: none;
}

/* 按钮样式 */
button {
  border-radius: 12rpx;
}

button[type="primary"] {
  background: #1890FF;
  color: white;
}

button[type="default"] {
  background: #F5F7FA;
  color: #666;
  border: 1rpx solid #E8E8E8;
}

/* 保存按钮 */
.save-btn {
  width: 80rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .form-section {
    padding: 24rpx;
  }
  
  .section-title {
    font-size: 26rpx;
  }
  
  .label {
    font-size: 26rpx;
    width: 100rpx;
  }
  
  .input {
    font-size: 26rpx;
  }
  
  .textarea {
    font-size: 26rpx;
  }
  
  .current-avatar {
    width: 100rpx;
    height: 100rpx;
  }
  
  .avatar-text {
    font-size: 40rpx;
  }
}