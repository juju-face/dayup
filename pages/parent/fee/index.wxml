<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 未选择孩子 -->
  <view wx:elif="{{!currentChild}}" class="empty-state">
    <text class="empty-icon">👨‍👩‍👧</text>
    <text class="empty-text">暂无孩子信息</text>
    <text class="empty-tip">请联系管理员绑定孩子信息后查看费用</text>
  </view>

  <!-- 有孩子信息 -->
  <block wx:else>
    <!-- 顶部橙色背景区域（包含导航栏、标题、孩子信息） -->
    <view class="header-section" style="padding-top:{{statusBarHeight}}px;">
      <!-- 自定义导航栏 -->
      <view class="nav-bar" style="height:{{navBarHeight}}px;">
        <view class="nav-content" style="height:{{navBarHeight}}px;">
          <view class="nav-back" style="height:{{navBarHeight}}px;line-height:{{navBarHeight}}px;" bindtap="handleBack">
            <text class="back-icon">‹</text>
          </view>
          <text class="nav-title">托管费用</text>
          <view class="nav-placeholder"></view>
        </view>
      </view>
      
      <!-- 孩子信息 -->
      <view class="child-header">
        <text class="child-name">{{currentChild.name}}</text>
        <text class="child-class">{{currentChild.school}} {{currentChild.className}}</text>
      </view>
    </view>

    <!-- 费用标准卡片 -->
    <view class="price-card">
      <view class="price-item">
        <text class="price-label">月托</text>
        <text class="price-value">{{feeInfo.priceMonth}}元/月</text>
      </view>
      <view class="price-item term">
        <text class="price-label">学期托</text>
        <view class="term-price">
          <text class="price-value">{{feeInfo.priceTerm}}元/学期</text>
          <text class="original-price" wx:if="{{feeInfo.originalPriceTerm}}">{{feeInfo.originalPriceTerm}}元</text>
        </view>
      </view>
      <view class="service-list">
        <view class="service-item" wx:for="{{feeInfo.services}}" wx:key="*this">
          <text class="service-icon">✓</text>
          <text class="service-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 当前状态卡片 -->
    <view class="status-card">
      <view class="status-header">
        <text class="status-label">缴费状态</text>
        <view class="status-badge {{feeInfo.paidStatus}}">
          {{feeInfo.paidStatus === 'paid' ? '已缴费' : '待缴费'}}
        </view>
      </view>
      <view class="days-section">
        <text class="days-label">剩余天数</text>
        <text class="days-value">{{feeInfo.remainingDays}}天</text>
      </view>
      <view class="expire-section">
        <text class="expire-label">到期日</text>
        <text class="expire-date">{{feeInfo.expireDate}}</text>
      </view>
      <view wx:if="{{feeInfo.paidStatus === 'paid'}}" class="paid-info">
        <text class="paid-text">✓ 本月已缴费</text>
      </view>
      <view wx:else class="pay-btn" bindtap="handlePay">
        <text class="pay-btn-text">立即缴费 ¥{{feeInfo.priceMonth}}</text>
      </view>
    </view>

    <!-- 缴费历史 -->
    <view class="history-section" wx:if="{{history.length > 0}}">
      <view class="history-title">缴费历史</view>
      <view class="history-list">
        <view class="history-item" wx:for="{{history}}" wx:key="date">
          <text class="history-date">{{item.date}}</text>
          <text class="history-amount">{{item.amount}}元</text>
          <view class="history-status {{item.status}}">
            {{item.status === 'paid' ? '已支付' : '待支付'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 无缴费记录 -->
    <view class="no-history" wx:if="{{history.length === 0}}">
      <text class="no-history-text">暂无缴费记录</text>
    </view>
  </block>
</view>
