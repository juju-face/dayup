.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding: 24rpx;
}

/* 调试切换角色按钮 */
.debug-switch {
  position: fixed;
  top: 120rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  z-index: 999;
}

.debug-switch-text {
  font-size: 22rpx;
  color: white;
}

/* 头部 */
.header {
  margin-bottom: 24rpx;
}

.child-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.child-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.today-date {
  font-size: 24rpx;
  color: #FF7A45;
}

/* 统计区域 */
.stats-section {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #52C41A;
  margin-bottom: 8rpx;
}

.stat-num.pending {
  color: #999;
}

.stat-num.warning {
  color: #FAAD14;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 作业卡片 */
.homework-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.card-count {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}

/* 作业项 */
.homework-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.homework-item:last-child {
  border-bottom: none;
}

.item-left {
  margin-right: 20rpx;
}

.subject-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 科目标签样式 - 使用英文类名 */
.subject-chinese {
  background: #E6F7FF;
  color: #1890FF;
}

.subject-math {
  background: #FFF1F0;
  color: #FF4D4F;
}

.subject-english {
  background: #F6FFED;
  color: #52C41A;
}

.subject-other {
  background: #F5F5F5;
  color: #666;
}

.item-center {
  flex: 1;
  margin-right: 20rpx;
}

.homework-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}

.item-right {
  flex-shrink: 0;
}

.status-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.status-0 {
  color: #999;
}

.status-1 {
  color: #52C41A;
}

.status-2 {
  color: #FAAD14;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 同步提示 */
.sync-tip {
  text-align: center;
  padding: 24rpx 0;
  margin-top: 24rpx;
}

.sync-text {
  font-size: 24rpx;
  color: #52C41A;
}
