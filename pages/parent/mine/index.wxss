.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 200rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 家庭信息卡 */
.family-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.family-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.parent-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.parent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F5F5;
}

.parent-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.parent-phone {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.parent-label {
  font-size: 22rpx;
  color: #FF7A45;
  background: #FFF8F0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.family-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEE;
}

.current-child-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid #FF7A45;
  background: #F5F5F5;
}

.child-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.child-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.child-class {
  font-size: 22rpx;
  color: #999;
}

/* 多孩切换 */
.children-tabs {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F5F5F5;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-right: 24rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #FFF8F0;
}

.tab-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #DDD;
}

.tab-item.active .tab-avatar {
  border-color: #FF7A45;
}

.tab-name {
  font-size: 22rpx;
  color: #666;
}

.tab-item.active .tab-name {
  color: #FF7A45;
  font-weight: 500;
}

/* 无孩子信息提示 */
.no-child-tip {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 32rpx 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tip-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.tip-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.tip-subtext {
  font-size: 26rpx;
  color: #999;
}

/* 费用状态卡 */
.fee-status-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.fee-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.fee-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fee-label {
  font-size: 24rpx;
  color: #999;
}

.fee-amount {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.fee-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF7A45;
}

.fee-unit {
  font-size: 24rpx;
  color: #999;
}

.fee-right {
  display: flex;
  align-items: center;
}

.status-badge {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.paid {
  background: #F6FFED;
  color: #52C41A;
}

.status-badge.pending {
  background: #FFF1F0;
  color: #FF4D4F;
}

.fee-info {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #F5F5F5;
  border-bottom: 1rpx solid #F5F5F5;
  margin-bottom: 24rpx;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EEE;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.info-value.warning {
  color: #FF4D4F;
}

.pay-btn {
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A6B 100%);
  border-radius: 48rpx;
  padding: 24rpx;
  text-align: center;
}

.pay-btn-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.renew-tip {
  background: #FFF1F0;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
}

.renew-text {
  font-size: 26rpx;
  color: #FF4D4F;
}

/* 详细信息卡 */
.detail-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.edit-link {
  font-size: 26rpx;
  color: #FF7A45;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.grid-item {
  width: calc(50% - 12rpx);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.grid-item.full {
  width: 100%;
}

.grid-label {
  font-size: 24rpx;
  color: #999;
}

.grid-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.grid-value.warning {
  color: #FF4D4F;
}

/* 空状态（未登录） */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

/* 底部操作 */
.action-section {
  position: fixed;
  bottom: 200rpx;
  left: 0;
  right: 0;
  padding: 0 32rpx;
  display: flex;
  gap: 24rpx;
}

.contact-btn {
  flex: 1;
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A6B 100%);
  border-radius: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.3);
}

.contact-btn.full-width {
  width: 100%;
}

.contact-btn-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.switch-btn {
  width: 200rpx;
  background: #FFFFFF;
  border: 2rpx solid #FF7A45;
  border-radius: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-btn-text {
  font-size: 28rpx;
  color: #FF7A45;
  font-weight: 500;
}

.safe-area {
  height: 40rpx;
}
