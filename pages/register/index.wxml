<view class="container {{role === 'teacher' ? 'teacher-theme' : 'parent-theme'}}">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">完善信息</text>
    <text class="subtitle">{{role === 'teacher' ? '请填写您的基本信息' : '请填写您的基本信息，孩子信息由后台统一管理'}}</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 角色提示 -->
    <view class="role-tip">
      <text class="role-tip-icon">{{role === 'teacher' ? '👨‍🏫' : '👨‍👩‍👧'}}</text>
      <text class="role-tip-text">{{role === 'teacher' ? '老师' : '家长'}}身份</text>
    </view>

    <!-- 姓名 -->
    <view class="input-item">
      <text class="input-label">姓名</text>
      <input 
        class="input-field" 
        placeholder="请输入您的姓名" 
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>

    <!-- 性别 -->
    <view class="input-item">
      <text class="input-label">性别</text>
      <picker mode="selector" range="{{['男', '女']}}" value="{{gender === 'male' ? 0 : 1}}" bindchange="onGenderChange">
        <view class="picker-text">
          {{gender === 'male' ? '男' : '女'}}
          <text class="arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 所属校区/学校（仅教师端显示） -->
    <view class="input-item" wx:if="{{role === 'teacher'}}">
      <text class="input-label">所属校区</text>
      <input 
        class="input-field" 
        placeholder="请输入所属校区" 
        value="{{school}}"
        bindinput="onSchoolInput"
      />
    </view>

    <!-- 手机号（只读） -->
    <view class="input-item">
      <text class="input-label">手机号</text>
      <text class="input-value">{{parentPhone}}</text>
    </view>

    <!-- 家长端提示 -->
    <view class="info-tip" wx:if="{{role === 'parent'}}">
      <text class="info-tip-icon">ℹ️</text>
      <text class="info-tip-text">孩子信息由后台管理系统统一管理，您可以在"我的"页面查看已绑定的孩子信息</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="handleSave">
    <text class="save-btn-text">保存并进入</text>
  </view>

  <!-- 底部提示 -->
  <view class="footer">
    <text class="footer-text">信息保存后可在个人中心修改</text>
  </view>
</view>
