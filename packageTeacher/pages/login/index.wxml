<view class="login-container">
  <view class="login-header">
    <text class="logo-emoji">🏫</text>
    <text class="title">老师登录</text>
    <text class="subtitle">作业管理系统</text>
  </view>

  <view class="login-form">
    <view class="form-item">
      <text class="label">手机号</text>
      <input 
        class="input" 
        type="number" 
        placeholder="请输入手机号"
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <text class="label">密码</text>
      <input 
        class="input" 
        type="password" 
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <button 
      class="login-btn"
      type="primary"
      bindtap="onLogin"
      loading="{{loading}}"
    >
      登录
    </button>

    <button 
      class="test-btn"
      type="default"
      bindtap="onTestLogin"
      size="mini"
    >
      测试登录
    </button>
  </view>

  <view class="login-footer">
    <text class="footer-text">© 2025 DayUp Education</text>
  </view>
</view>
