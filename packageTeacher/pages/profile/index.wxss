/* 全局样式 */
page {
  background: linear-gradient(180deg, #EBF5FF 0%, #F5F7FA 100%);
  font-family: 'PingFang SC', sans-serif;
}

.profile-container {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 班级切换 */
.class-switch {
  background: white;
  padding-bottom: 24rpx;
}

.class-scroll {
  display: flex;
  padding: 32rpx;
  padding-bottom: 16rpx;
  white-space: nowrap;
}

.class-tag {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: white;
  color: #666;
  font-size: 28rpx;
  margin-right: 16rpx;
  border: 2rpx solid #E8E8E8;
  transition: all 0.3s ease;
}

.class-tag.active {
  background: #1890FF;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  border-color: #1890FF;
}

.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #E8E8E8 50%, transparent 100%);
  margin: 0 32rpx;
}

/* 卡片通用样式 */
.overview-card,
.tools-card,
.insight-card,
.parent-card {
  background: white;
  margin: 32rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
}

/* 今日概览 */
.overview-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.overview-item {
  flex: 1;
  text-align: center;
  padding: 0 12rpx;
}

.overview-number {
  font-size: 56rpx;
  font-weight: bold;
  font-family: 'DIN Alternate', sans-serif;
  margin-bottom: 8rpx;
}

.overview-number.blue {
  color: #1890FF;
}

.overview-number.green {
  color: #52C41A;
}

.overview-number.orange {
  color: #FF7A45;
}

.overview-number.red {
  color: #FF4D4F;
}

.overview-number.gray {
  color: #666;
}

.percent-sign {
  font-size: 32rpx;
}

.overview-label {
  font-size: 24rpx;
  color: #666;
}

.trend-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
}

/* 效率工具 */
.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.1s ease;
}

.tool-item:active {
  transform: scale(0.95);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.tool-icon.blue-gradient {
  background: linear-gradient(135deg, #40A9FF 0%, #1890FF 100%);
}

.tool-icon.purple-gradient {
  background: linear-gradient(135deg, #B37FEB 0%, #722ED1 100%);
}

.tool-icon.cyan-gradient {
  background: linear-gradient(135deg, #36CFC9 0%, #13C2C2 100%);
}

.tool-icon.orange-gradient {
  background: linear-gradient(135deg, #FFC069 0%, #FA8C16 100%);
}

.tool-icon .icon {
  font-size: 48rpx;
  color: white;
}

.tool-label {
  font-size: 26rpx;
  color: #1A1A1A;
  text-align: center;
}

/* 数据洞察 */
.trend-section {
  margin-bottom: 32rpx;
}

.trend-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.trend-bars {
  display: flex;
  gap: 12rpx;
  align-items: flex-end;
  height: 120rpx;
}

.trend-bar {
  flex: 1;
  background: #F0F0F0;
  border-radius: 4rpx 4rpx 0 0;
  position: relative;
  min-height: 20rpx;
  transition: all 0.3s ease;
}

.trend-bar.today {
  background: #1890FF;
}

.bar-label {
  position: absolute;
  bottom: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #999;
}

.bar-value {
  position: absolute;
  top: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #666;
  font-weight: bold;
}

.attention-section {
  margin-top: 32rpx;
}

.attention-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.student-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.student-item:last-child {
  border-bottom: none;
}

.student-info {
  display: flex;
  align-items: center;
}

.student-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #E8F3FF;
  color: #1890FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.student-details {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.student-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.completion-tag {
  padding: 4rpx 12rpx;
  background: #FF4D4F;
  color: white;
  font-size: 20rpx;
  border-radius: 16rpx;
}

.arrow {
  font-size: 32rpx;
  color: #CCC;
  font-weight: bold;
}

/* 家长沟通 */
.parent-buttons {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.parent-button {
  flex: 1;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: white;
  font-size: 26rpx;
  font-weight: bold;
}

.parent-button.left {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

.parent-button.right {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
}

.parent-button.red-gradient {
  background: linear-gradient(135deg, #FF7875 0%, #FF4D4F 100%);
}

.parent-button.blue-bg {
  background: #1890FF;
}

.button-icon {
  font-size: 32rpx;
}

.parent-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
}

/* 系统设置 */
.settings-section {
  background: white;
  margin: 0 32rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  height: 96rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  color: #1A1A1A;
}

.setting-icon.orange {
  color: #FF7A45;
}

.setting-icon.gray {
  color: #999;
}

.setting-label {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.version {
  font-size: 24rpx;
  color: #999;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

@keyframes countUp {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 0.3s ease-out;
}

.pulse {
  animation: pulse 1s infinite;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .overview-number {
    font-size: 48rpx;
  }
  
  .tool-icon {
    width: 72rpx;
    height: 72rpx;
  }
  
  .tool-icon .icon {
    font-size: 40rpx;
  }
  
  .parent-button {
    height: 80rpx;
    font-size: 24rpx;
  }
}