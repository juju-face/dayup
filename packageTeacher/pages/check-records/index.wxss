/* packageTeacher/pages/check-records/index.wxss */

.page {
  min-height: 100vh;
  background-color: var(--teacher-bg);
  color: var(--teacher-text-primary);
}

/* 顶部 Segmented Control */
.segmented-control {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 80rpx;
  background-color: #F5F7FA;
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.segment-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
  border-radius: 8rpx;
  transition: all 0.3s ease;
  margin: 0 4rpx;
}

.segment-active {
  background-color: #FFFFFF;
  color: #1890FF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 面板样式 */
.panel {
  padding: 0 24rpx;
}

/* 今日记录面板 */
.today-stats {
  display: flex;
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.today-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.today-stat-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.today-stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  font-family: 'DIN Alternate', 'Helvetica Neue', Arial, sans-serif;
}

/* 记录列表 */
.records-list {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 24rpx;
  background-color: white;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.record-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.record-name {
  font-weight: 500;
  margin-bottom: 4rpx;
}

.record-time-slot {
  color: #999999;
}

.record-time {
  margin-right: 16rpx;
  text-align: right;
}

.time-text {
  font-size: 26rpx;
  color: #666666;
  font-family: monospace;
}

.status-tag {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-pending {
  background-color: #FFF1F0;
  color: #FF4D4F;
}

.record-status {
  flex-shrink: 0;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-green {
  background-color: #52C41A;
}

.status-orange {
  background-color: #FAAD14;
}

/* 空状态 */
.empty-container {
  padding: 80rpx 24rpx;
}

/* 补签管理面板 */
.makeup-form {
  padding: 24rpx 0;
}

.form-step {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.step-title {
  margin-bottom: 16rpx;
  font-weight: 600;
}

.picker-value {
  font-size: 28rpx;
  color: #1890FF;
  padding: 16rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  text-align: center;
}

.student-selection {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.student-option {
  width: calc(33.333% - 10.666rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.3s ease;
}

.student-option.selected {
  background-color: #E6F7FF;
  border: 2rpx solid #1890FF;
}

.student-option-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.student-option-name {
  font-size: 24rpx;
  color: #1A1A1A;
  text-align: center;
}

.selected-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 24rpx;
  height: 24rpx;
  background-color: #1890FF;
  color: white;
  border-radius: 50%;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-selection {
  text-align: center;
  padding: 40rpx;
  color: #999999;
}

.time-input {
  font-size: 28rpx;
  padding: 16rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  text-align: center;
  font-family: monospace;
}

.submit-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #1890FF;
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 8rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}

/* 数据查询面板 */
.query-filters {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-picker {
  font-size: 26rpx;
  color: #1890FF;
  padding: 12rpx 16rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  min-width: 160rpx;
  text-align: center;
}

.filter-separator {
  margin: 0 16rpx;
  color: #999999;
  font-size: 26rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox-label, .radio-label {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.checkbox-label checkbox, .radio-label radio {
  margin-right: 8rpx;
}

.query-btn, .export-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 8rpx;
  margin: 0 8rpx;
  border: none;
}

.query-btn {
  background-color: #1890FF;
  color: white;
}

.export-btn {
  background-color: #52C41A;
  color: white;
}

.query-btn::after, .export-btn::after {
  border: none;
}

.query-results {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.loading-more {
  text-align: center;
  padding: 24rpx;
  color: #999999;
  font-size: 24rpx;
}
