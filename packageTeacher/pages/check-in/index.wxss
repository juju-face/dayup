/* packageTeacher/pages/check-in/index.wxss */

.container {
  min-height: 100vh;
  background-color: var(--bg-gray);
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 页面标题 */
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

/* 签到/签退切换 - Segmented Control */
.segmented-control {
  display: flex;
  background-color: #F0F0F0;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  height: 72rpx;
  overflow: hidden;
}

.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
}

.segment-active {
  background-color: #1890FF;
}

.segment-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #666666;
  transition: all 0.3s ease;
}

.segment-active .segment-text {
  color: var(--white);
}

/* 固定时段选择器 */
.time-slot-section {
  background-color: var(--white);
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  position: sticky;
  top: 0;
  z-index: 100;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.picker {
  padding: 24rpx;
  font-size: 32rpx;
  color: var(--text-primary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.picker::after {
  content: "▼";
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 最近签到记录 */
.record-section {
  background-color: var(--white);
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.record-list {
  /* 无padding，信息密度高 */
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  height: 120rpx;
}

.record-item:last-child {
  border-bottom: none;
}

/* 头像 */
.record-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
  border-radius: 50%;
}

.avatar-icon {
  font-size: 40rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.record-child {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.record-type {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.type-checkIn {
  background-color: #E8FFF0;
  color: #33CC66;
}

.type-checkOut {
  background-color: #FFF0E8;
  color: #FF9966;
}

/* 状态指示器 */
.status-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #33CC66;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  font-weight: bold;
}

.status-indicator.checkOut {
  background-color: #FF9966;
  border-radius: 0;
  width: 16rpx;
  height: 16rpx;
  font-size: 16rpx;
}

.record-type-text {
  font-size: 24rpx;
}

/* 空记录提示 */
.empty-record {
  padding: 60rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 底部悬浮模拟扫码按钮 */
.scan-button {
  position: fixed;
  bottom: 48rpx;
  left: 10%;
  right: 10%;
  background-color: #1890FF;
  border-radius: 48rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.4);
  transition: all 0.3s ease;
  min-height: 100rpx;
  justify-content: center;
}

.scan-button:active {
  background-color: #096DD9;
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(24, 144, 255, 0.6);
}

.scan-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.scan-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--white);
}

