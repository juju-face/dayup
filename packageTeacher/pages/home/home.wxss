/* packageTeacher/pages/home/home.wxss */

/* 页面背景强制 #F5F7FA */
.teacher-home {
  min-height: 100vh;
  background: #F5F7FA !important;
}

/* 容器样式 */
.t-container {
  padding-bottom: 120rpx;
}

/* 顶部时段栏 */
.time-slot-bar {
  height: 120rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-bottom: 1rpx solid #EEEEEE;
}

.time-slot-info {
  flex: 1;
}

.time-slot-name {
  font-weight: 600;
  margin-bottom: 4rpx;
}

.time-slot-range {
  color: #666666;
}

.time-slot-picker {
  font-size: 28rpx;
  color: #1890FF;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #F0F8FF;
}

/* 统计卡片区 - 使用 flex 三列布局，边框 1rpx solid #EEEEEE 分隔 */
.stats-section {
  margin: 24rpx;
}

.stats-grid {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  height: 200rpx;
  overflow: hidden;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #EEEEEE;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  margin-bottom: 8rpx;
}

.stat-label {
  color: #666666;
}

/* 待签退警示区 */
.warning-section {
  margin: 0 24rpx 24rpx;
  background-color: #FFF1F0;
  border: 1rpx solid #FFCCC7;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.warning-section:active {
  background-color: #FFECE8;
}

.warning-content {
  display: flex;
  align-items: center;
}

.warning-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 28rpx;
  color: #FF4D4F;
  flex: 1;
}

/* 在班学生网格 - 使用 .student-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 24rpx; } */
.students-section {
  padding: 0 24rpx 24rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-weight: 600;
}

.students-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 学生项宽度 calc(25% - 12rpx)，头像 80rpx 方角 12rpx */
.student-item {
  width: calc(25% - 12rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.student-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  border: 2rpx solid #F0F0F0;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.student-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.student-name {
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  margin-bottom: 8rpx;
}

.student-status {
  font-size: 24rpx;
  color: #1890FF;
  background-color: #E6F7FF;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty-students {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 24rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  color: #D9D9D9;
}

.empty-text {
  color: #666666;
}

/* 响应式适配 */
@media screen and (max-width: 750rpx) {
  .student-item {
    width: calc(33.333% - 10.666rpx);
  }
}

@media screen and (max-width: 480rpx) {
  .student-item {
    width: calc(50% - 8rpx);
  }
}

/* 悬浮按钮固定定位：position: fixed; right: 32rpx; bottom: 160rpx; width: 96rpx; height: 96rpx; background: #1890FF; border-radius: 50%; box-shadow: 0 4rpx 20rpx rgba(24,144,255,0.4); */
.float-check-btn {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  background: #1890FF;
  border-radius: 50%;
  box-shadow: 0 4rpx 20rpx rgba(24, 144, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  transition: transform 0.1s ease;
}

.float-check-btn:active {
  transform: scale(0.92);
}

.float-check-btn .iconfont {
  font-size: 48rpx;
  color: white;
}

.float-check-text {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  background: #1890FF;
  color: white;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  z-index: 99;
}
