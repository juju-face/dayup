/* packageTeacher/pages/homework-publish/homework-publish.wxss */

.container {
  padding: 30rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* 草稿提示 */
.draft-tip {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
  border: 2rpx solid #ffc107;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.draft-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.draft-text {
  flex: 1;
  font-size: 28rpx;
  color: #856404;
}

.draft-actions {
  display: flex;
  gap: 20rpx;
}

.draft-action {
  font-size: 28rpx;
  color: #409eff;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(64, 158, 255, 0.1);
}

.draft-action:active {
  background: rgba(64, 158, 255, 0.2);
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #303133;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.header-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #409eff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(64, 158, 255, 0.1);
}

.header-action:active {
  background: rgba(64, 158, 255, 0.2);
}

.action-icon {
  font-size: 32rpx;
}

/* 模式切换 */
.mode-switch {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #606266;
  transition: all 0.3s ease;
}

.mode-item.active {
  background: #409eff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
}

.mode-icon {
  font-size: 32rpx;
}

/* 区块样式 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.section-subtitle {
  font-size: 28rpx;
  color: #909399;
}

.section-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #409eff;
}

/* 学生网格 */
.student-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.student-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 16rpx;
  background: #fff;
  transition: all 0.3s ease;
}

.student-item:active {
  transform: scale(0.95);
}

.student-item.selected {
  border-color: #409eff;
  background: rgba(64, 158, 255, 0.05);
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #409eff 0%, #337ecc 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.student-name {
  font-size: 28rpx;
  color: #303133;
  text-align: center;
}

.select-indicator {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #409eff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

/* 单选学生选择器 */
.single-student-picker {
  width: 100%;
}

.picker-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 16rpx;
  background: #fff;
}

.picker-placeholder {
  font-size: 30rpx;
  color: #c0c4cc;
}

.picker-value {
  font-size: 30rpx;
  color: #303133;
  font-weight: 500;
}

.picker-arrow {
  font-size: 28rpx;
  color: #c0c4cc;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 科目选择器 */
.subject-selector {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.subject-tag {
  padding: 20rpx 40rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #606266;
  background: #fff;
  transition: all 0.3s ease;
}

.subject-tag.active {
  border-color: #409eff;
  background: #409eff;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
}

.subject-tag:active {
  transform: scale(0.95);
}

/* 输入框 */
.content-input, .remark-input {
  width: 100%;
  min-height: 160rpx;
  padding: 30rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #303133;
  background: #fff;
  box-sizing: border-box;
}

.remark-input {
  min-height: 120rpx;
}

.placeholder {
  color: #c0c4cc;
}

.input-count {
  text-align: right;
  font-size: 24rpx;
  color: #909399;
  margin-top: 10rpx;
}

/* 日期选择器 */
.date-picker {
  width: 100%;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid #e4e7ed;
}

.bar-left {
  flex: 1;
}

.preview-btn {
  font-size: 28rpx;
  color: #606266;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
}

.preview-btn:active {
  background: #f5f7fa;
}

.bar-right {
  flex-shrink: 0;
}

.publish-btn {
  min-width: 240rpx;
  height: 88rpx;
  padding: 0 60rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #409eff 0%, #337ecc 100%);
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
  transition: all 0.3s ease;
}

.publish-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(64, 158, 255, 0.3);
}

.publish-btn[disabled] {
  opacity: 0.6;
  background: #c0c4cc;
  box-shadow: none;
}

/* 模板弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.template-modal {
  width: 90%;
  max-width: 700rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  animation: modalSlideUp 0.3s ease;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(50rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f5f7fa;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #303133;
}

.modal-close {
  font-size: 48rpx;
  color: #909399;
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  max-height: 60vh;
  overflow: hidden;
}

.template-list {
  max-height: 60vh;
}

.empty-templates {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #c0c4cc;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
}

.template-item {
  padding: 30rpx;
  border-bottom: 2rpx solid #f5f7fa;
  transition: all 0.3s ease;
}

.template-item:active {
  background: #f5f7fa;
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.template-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #303133;
}

.template-subject {
  font-size: 24rpx;
  color: #409eff;
  background: rgba(64, 158, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.template-content {
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.template-time {
  font-size: 24rpx;
  color: #909399;
}
