/* styles/typography.wxss */

/* 字体族设置 */
@font-face {
  font-family: 'DIN Alternate';
  src: local('DIN Alternate');
}

/* 基础字体设置 */
page {
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--text-primary);
  background-color: var(--bg-gray);
}

/* 字体层级系统 */

/* 主标题：36rpx / 字重 600 / 行高 48rpx（页面大标题） */
.text-heading-1 {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
  color: var(--text-primary);
}

/* 副标题：32rpx / 字重 600 / 行高 44rpx（卡片标题） */
.text-heading-2 {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--text-primary);
}

/* 正文大：30rpx / 字重 400 / 行高 44rpx（主要内容） */
.text-body-large {
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
  color: var(--text-primary);
}

/* 正文常规：28rpx / 字重 400 / 行高 42rpx（列表文字） */
.text-body {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 42rpx;
  color: var(--text-primary);
}

/* 辅助文字：24rpx / 字重 400 / 行高 34rpx（时间、标签） */
.text-caption {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 34rpx;
  color: var(--text-secondary);
}

/* 说明文字：22rpx / 字重 300 / 行高 32rpx（提示、角标） */
.text-small {
  font-size: 22rpx;
  font-weight: 300;
  line-height: 32rpx;
  color: var(--text-tertiary);
}

/* 数字展示字体 */
.text-numeric {
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

/* 颜色层级 */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-white {
  color: var(--text-white);
}

/* 背景色类 */
.bg-white {
  background-color: var(--white);
}

.bg-gray {
  background-color: var(--bg-gray);
}

.bg-primary {
  background-color: var(--primary-color);
}
