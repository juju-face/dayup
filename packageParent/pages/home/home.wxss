/* packageParent/pages/home/home.wxss */

.container {
  min-height: 100vh;
  background-color: var(--bg-gray);
  padding-bottom: 160rpx;
}

/* 轮播图 */
.banner {
  width: calc(100% - 64rpx);
  height: 320rpx;
  margin: 32rpx 32rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.banner swiper {
  width: 100%;
  height: 100%;
}

.banner-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
}

.banner-1 {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.banner-2 {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.banner-3 {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.banner-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 欢迎语 */
.welcome {
  padding: 32rpx;
}

.welcome-text {
  font-size: 40rpx;
  font-weight: bold;
  font-family: 'PingFang SC', cursive;
  color: var(--text-primary);
  line-height: 56rpx;
}

/* 快捷入口 */
.quick-entry {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background-color: var(--white);
  margin: 0 32rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 33.33%;
  min-height: 120rpx;
  justify-content: center;
}

.entry-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF5E6 0%, #FFE4CC 100%);
  box-shadow: 0 2rpx 8rpx rgba(255, 149, 0, 0.1);
}

.entry-text {
  font-size: 24rpx;
  color: var(--text-primary);
  text-align: center;
}

/* 托管时段 */
.time-slots {
  padding: 0 32rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.time-slot-card {
  background-color: var(--white);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.time-slot-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.time-slot-info {
  margin-bottom: 24rpx;
}

.time-slot-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.time-slot-range {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.time-slot-price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
}

.price-number {
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
  font-size: 32rpx;
  font-weight: 600;
}

.time-slot-status {
  margin-top: 24rpx;
}

.status-text {
  font-size: 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.status-tip {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.status-bar {
  width: 100%;
  height: 12rpx;
  background-color: var(--bg-gray);
  border-radius: 6rpx;
  overflow: hidden;
}

.status-fill {
  height: 100%;
  background-color: var(--primary-color);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 切换角色按钮 */
.switch-role {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
  background-color: var(--white);
  border: 2rpx solid var(--primary-color);
  border-radius: 48rpx;
  padding: 24rpx;
  text-align: center;
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 20rpx rgba(255, 149, 0, 0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.switch-role:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(255, 149, 0, 0.08);
}

