/* packageParent/pages/messages/index.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background: white;
  padding: 16rpx 32rpx;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  background: #F5F7FA;
  transition: all 0.3s;
}

.tab-item.active {
  background: #1890FF;
  color: white;
  font-weight: 500;
}

/* 消息列表 */
.message-list {
  padding: 0 32rpx 32rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.message-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.message-card.unread {
  border-left: 6rpx solid #1890FF;
  background: #F0F7FF;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.message-type {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.type-homework {
  background: #E6F7FF;
  color: #1890FF;
}

.type-feedback {
  background: #F6FFED;
  color: #52C41A;
}

.message-time {
  font-size: 22rpx;
  color: #999;
}

.message-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.message-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.message-child {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.message-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #E8E8E8;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.action-btn.primary {
  background: #1890FF;
  color: white;
  border-color: #1890FF;
}

.action-btn:active {
  opacity: 0.8;
}
