<!-- packageParent/pages/child-list/child-list.wxml -->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <text class="title">我的孩子</text>
    <view class="add-button" bindtap="navigateToAddChild">
      <text class="add-icon">+</text>
      <text class="add-text">添加孩子</text>
    </view>
  </view>
  
  <!-- 孩子列表 -->
  <view class="child-grid">
    <block wx:for="{{ childrenList }}" wx:key="{{ item.id }}">
      <view class="child-card" bindtap="navigateToEditChild" data-child-id="{{ item.id }}">
        <movable-area class="movable-area">
          <movable-view class="movable-view" direction="horizontal" out-of-bounds>
            <view class="card-content">
              <view class="child-avatar">
                <image wx:if="{{ item.avatarUrl }}" src="{{ item.avatarUrl }}" mode="aspectFill"></image>
                <view wx:else class="avatar-placeholder">
                  <text class="avatar-icon">👶</text>
                </view>
              </view>
              <view class="child-info">
                <view class="child-name">{{ item.name }}</view>
                <view class="child-age">{{ item.age }}岁</view>
                <view class="child-school">{{ item.school }}</view>
              </view>
            </view>
          </movable-view>
          <view class="delete-button" bindtap="deleteChild" data-child-id="{{ item.id }}">
            <text class="delete-text">删除</text>
          </view>
        </movable-area>
      </view>
    </block>
  </view>
  
  <!-- 空数据提示 -->
  <view wx:if="{{ childrenList.length === 0 }}" class="empty-container">
    <empty-state text="暂无孩子信息" btn-text="添加孩子" bind:btnClick="navigateToAddChild"></empty-state>
  </view>
</view>