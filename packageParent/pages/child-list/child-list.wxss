/* packageParent/pages/child-list/child-list.wxss */

.container {
  min-height: 100vh;
  background-color: var(--bg-gray);
  padding: 24rpx;
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 顶部操作栏 */
.header {
  background-color: var(--white);
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  position: sticky;
  top: 24rpx;
  z-index: 100;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.add-button {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background-color: var(--primary-color);
  color: var(--white);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  min-height: 64rpx;
}

.add-button:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 149, 0, 0.3);
}

.add-icon {
  font-size: 28rpx;
  font-weight: 600;
}

/* 孩子网格 */
.child-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

/* 孩子卡片 */
.child-card {
  background-color: var(--white);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s ease;
  animation: cardFadeIn 0.5s ease-in-out;
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.child-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 可移动区域 */
.movable-area {
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.movable-view {
  width: 100%;
  height: 100%;
}

/* 卡片内容 */
.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  height: 100%;
}

/* 孩子头像 */
.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 4rpx solid var(--white);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.child-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFF5E6;
  border-radius: 50%;
}

.avatar-icon {
  font-size: 56rpx;
}

/* 孩子信息 */
.child-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  text-align: center;
}

.child-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 42rpx;
}

.child-age {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 34rpx;
}

.child-school {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 34rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 删除按钮 */
.delete-button {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 100%;
  background: linear-gradient(135deg, #FF4D4F 0%, #FF7875 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: -4rpx 0 12rpx rgba(255, 77, 79, 0.3);
}

.delete-text {
  color: var(--white);
  font-size: 28rpx;
  font-weight: 600;
}

/* 空数据容器 */
.empty-container {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

