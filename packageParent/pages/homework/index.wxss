.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 40rpx;
}

/* 顶部：今日日期 */
.header {
  padding: 32rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.today-date {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.sync-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.last-update {
  opacity: 0.8;
}

.refresh-btn {
  padding: 8rpx;
  border-radius: 50%;
  background: rgba(255, 122, 69, 0.1);
  cursor: pointer;
  transition: all 0.3s ease;
}

.refresh-btn:active {
  transform: scale(0.9);
}

.refresh-icon {
  font-size: 24rpx;
  color: #FF7A45;
}

/* 今日作业卡片 */
.homework-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  min-height: 50vh;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.empty-tip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  opacity: 0.8;
}

.homework-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.homework-item:last-child {
  border-bottom: none;
}

.item-left {
  margin-right: 20rpx;
}

.subject-tag {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.subject-chinese {
  background: #E6F7FF;
  color: #1890FF;
}

.subject-math {
  background: #FFF1F0;
  color: #FF4D4F;
}

.subject-english {
  background: #F6FFED;
  color: #52C41A;
}

.subject-other {
  background: #F5F5F5;
  color: #666;
}

.item-center {
  flex: 1;
  min-width: 0;
}

.homework-content {
  font-size: 30rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.item-right {
  margin-left: 20rpx;
}

.status-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.status-0 {
  color: #999;
}

.status-1 {
  color: #52C41A;
}

.status-2 {
  color: #FAAD14;
}




