.container {
  min-height: 100vh;
  background: #FFF8F0;
  padding-bottom: 180rpx;
}

/* 头部卡片 */
.header-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.avatar-wrapper {
  margin-bottom: 24rpx;
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FF7A45;
  background: #F5F5F5;
}

.child-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.child-class {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.enroll-date {
  font-size: 24rpx;
  color: #999;
}

/* 基本信息列表 */
.info-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 0 32rpx 32rpx;
  padding: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-item.allergy {
  background: #FFF1F0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.copy-icon {
  font-size: 24rpx;
}

.allergy-text {
  color: #FF4D4F;
  font-weight: 500;
}

/* 操作按钮 */
.btn-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn {
  flex: 1;
  border-radius: 48rpx;
  padding: 28rpx;
  text-align: center;
}

.edit-btn {
  background: #F5F5F5;
}

.contact-btn {
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A6B 100%);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 500;
}

.edit-btn .btn-text {
  color: #666;
}

.contact-btn .btn-text {
  color: #FFFFFF;
}

.safe-area {
  height: 40rpx;
}
