/* packageParent/pages/enroll/index.wxss */

.container {
  min-height: 100vh;
  background-color: var(--bg-gray);
  padding: 16rpx;
}

/* 时段信息卡片 */
.time-slot-card {
  background-color: var(--white);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.time-slot-header {
  background-color: var(--primary-color);
  padding: 16rpx 20rpx;
}

.time-slot-title {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--white);
}

.time-slot-content {
  padding: 20rpx;
}

.time-slot-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.time-slot-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 14rpx;
  color: var(--text-secondary);
  width: 80rpx;
}

.value {
  font-size: 14rpx;
  color: var(--text-primary);
  flex: 1;
}

.value.price {
  color: var(--primary-color);
  font-weight: 500;
}

/* 孩子选择区域 */
.child-section {
  background-color: var(--white);
  border-radius: 16rpx;
  margin-bottom: 120rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.section-title {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

/* 无孩子提示 */
.no-children {
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.no-children-text {
  font-size: 14rpx;
  color: var(--text-secondary);
}

.add-child-button {
  background-color: var(--primary-color);
  color: var(--white);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 14rpx;
  font-weight: 500;
}

/* 孩子选择列表 */
.child-list {
  padding: 16rpx 0;
}

.child-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.child-item:last-child {
  border-bottom: none;
}

.child-item-selected {
  background-color: #F5F8FF;
}

.child-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 16rpx;
}

.child-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-gray);
}

.avatar-icon {
  font-size: 30rpx;
}

.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.child-name {
  font-size: 16rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.child-details {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.detail-item {
  font-size: 12rpx;
  color: var(--text-secondary);
}

.radio {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-checked {
  border-color: var(--primary-color);
  background-color: var(--primary-color);
}

.radio-inner {
  width: 12rpx;
  height: 12rpx;
  background-color: var(--white);
  border-radius: 50%;
}

/* 底部价格和提交按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--white);
  padding: 20rpx;
  border-top: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.price-info {
  display: flex;
  align-items: center;
}

.price-label {
  font-size: 14rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-left: 8rpx;
}

.submit-button {
  background-color: var(--primary-color);
  color: var(--white);
  padding: 12rpx 32rpx;
  border-radius: 20rpx;
  font-size: 16rpx;
  font-weight: 500;
}
