<view class="container">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="avatar-section">
      <view class="avatar-circle">
        <text class="avatar-text">{{profile.name ? profile.name.charAt(0) : '用'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{profile.name || '用户'}}</text>
        <text class="user-role">家长身份</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="bindChild">
      <text class="menu-icon">👶</text>
      <text class="menu-text">绑定孩子</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="viewRecords">
      <text class="menu-icon">📋</text>
      <text class="menu-text">打卡记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="viewFee">
      <text class="menu-icon">💰</text>
      <text class="menu-text">缴费记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactTeacher">
      <text class="menu-icon">📞</text>
      <text class="menu-text">联系老师</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="about">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <view class="logout-btn" bindtap="logout">
      <text class="logout-text">退出登录</text>
    </view>
  </view>

  <view class="safe-area"></view>
</view>
