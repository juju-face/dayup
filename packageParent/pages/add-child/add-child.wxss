/* packageParent/pages/add-child/add-child.wxss */

.container {
  min-height: 100vh;
  background-color: var(--bg-gray);
  padding: 32rpx;
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 页面标题 */
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 32rpx;
  text-align: center;
}

/* 表单分组 */
.form-group {
  background-color: var(--white);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.group-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

/* 头像上传 */
.avatar-upload {
  padding: 48rpx;
  display: flex;
  justify-content: center;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx dashed #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.3s ease;
}

.avatar-preview:active {
  transform: scale(0.98);
}

.avatar-preview image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  writing-mode: vertical-rl;
  text-orientation: upright;
}

.avatar-text {
  font-size: 24rpx;
  color: #BBBBBB;
  letter-spacing: 8rpx;
}

/* 表单项目 */
.form-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  display: flex;
  align-items: center;
}

.required {
  color: var(--danger-color);
  margin-left: 8rpx;
  font-size: 24rpx;
}

.input {
  font-size: 32rpx;
  color: var(--text-primary);
  padding: 16rpx 0;
  border: none;
  outline: none;
  border-bottom: 1rpx solid #F0F0F0;
}

.input::placeholder {
  color: #BBBBBB;
  font-size: 30rpx;
}

.textarea {
  font-size: 32rpx;
  color: var(--text-primary);
  padding: 16rpx 0;
  border: none;
  outline: none;
  min-height: 160rpx;
  resize: none;
  border-bottom: 1rpx solid #F0F0F0;
}

.textarea::placeholder {
  color: #BBBBBB;
  font-size: 30rpx;
}

/* 性别选择 */
.radio-group {
  display: flex;
  gap: 80rpx;
  margin-top: 8rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #F0F0F0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.radio-checked {
  border-color: var(--primary-color);
  background-color: var(--primary-color);
}

.radio-inner {
  width: 16rpx;
  height: 16rpx;
  background-color: var(--white);
  border-radius: 50%;
}

.radio-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 错误提示 */
.error-message {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.error-icon {
  font-size: 24rpx;
}

.error-message text {
  font-size: 24rpx;
  color: #FF4D4F;
}

/* 保存按钮 */
.save-button {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--primary-color);
  color: var(--white);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(255, 149, 0, 0.2);
  transition: all 0.3s ease;
}

.save-button:active {
  animation: bounce 0.3s ease;
}

@keyframes bounce {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

.safe-area-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}